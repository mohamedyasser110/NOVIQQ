# .env.example — safe placeholders only. Never commit real .env
# Copy: Copy-Item .env.example .env

# --- Database (SQLite local / Postgres production) ---
# Local dev (SQLite file):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, uncomment + set real secret via env manager):
# DATABASE_URL="postgresql://user:***@host:5432/company_os?schema=public"

# --- PHP API (native, cPanel) — البديل النشط لـ Nest ---
# Local dev (SQLite file, zero-config):
DB_DRIVER=sqlite
# Production MySQL (cPanel):
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=xxx_company
# DB_USER=xxx_user
# DB_PASS=***set-via-env-manager***
API_PORT=4100
API_PREFIX=/api
JWT_ACCESS_SECRET=change-me-32-chars-min-dev-only
JWT_REFRESH_SECRET=change-me-32-chars-min-dev-only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ORIGIN=http://localhost:3100

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4100/api

# --- Bootstrap (first-run admin, dev only; disabled in production) ---
BOOTSTRAP_ENABLED=true
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=ChangeMe123!

# --- Company defaults (reversible, see docs/DECISIONS.md) ---
COMPANY_CURRENCY=EGP
COMPANY_TIMEZONE=Africa/Cairo
EARN_CONDITION=project_delivery_and_collection
PAYOUT_APPROVAL_MODE=two_person
